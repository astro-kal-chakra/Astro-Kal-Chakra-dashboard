# Copy to .env.local. Server-side only: none of these reach the browser.

# Backend (D:\AstroBackend) base URL, without /api/v1.
API_BASE_URL=https://api.astrokaalchakra.com

# How many proxies (this Next server included) sit in front of the browser.
# The admin's IP for audit logs and rate limits is read that many entries from
# the right of X-Forwarded-For. 1 = Next.js serves browsers directly.
TRUSTED_PROXY_HOPS=1

# Session cookie lifetime in days. Keep it equal to the backend's ADMIN_REFRESH_TOKEN_DAYS.
ADMIN_SESSION_DAYS=1
